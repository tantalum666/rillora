NODE_ENV=development
HOST=127.0.0.1
PORT=4180
DATABASE_URL=postgresql:///continuity_dev
# Cloud deployments inject DATABASE_HOST / PORT / NAME / USER / PASSWORD instead of DATABASE_URL.
# Production also requires DATABASE_SSL_MODE=verify-full and DATABASE_SSL_CA_PATH.
CORS_ORIGINS=http://localhost:4173,http://localhost:4174
ALLOW_DEV_AUTH=true
# Local-only synthetic recipient acceptance and decryption rehearsal. Production rejects this flag.
ALLOW_SYNTHETIC_RECIPIENT_REHEARSAL=true
# Official Stripe SDK test adapter. It is off by default and may be enabled only when every value
# below comes from a secret manager. The API key must be a least-privilege restricted test key with
# an rk_test_ prefix; never use sk_test_ or live-mode values. This file must never contain real keys.
ALLOW_STRIPE_TEST_INTEGRATION=false
# Production-shaped staging additionally requires STRIPE_TEST_STAGING_MODE=true and the exact
# Rillora staging origin/account/catalog bindings. Leave false for local tests.
STRIPE_TEST_STAGING_MODE=false
# Official Apple StoreKit Sandbox verifier and App Store Server API adapter. Keep the gate off
# unless the entire root-certificate path is configured. The key/issuer/private-key values are an
# all-or-none set and must come from ignored local secret storage or a secret manager, never this file.
ALLOW_APPLE_SANDBOX_INTEGRATION=false
# Production-shaped staging additionally requires APPLE_SANDBOX_STAGING_MODE=true. Leave false for
# the local Debug-only Sandbox purchase harness.
APPLE_SANDBOX_STAGING_MODE=false
DATABASE_POOL_MAX=10
TRUST_PROXY_HOPS=0
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30
AUTH_TRANSACTION_TTL_SECONDS=600
DATA_REGION=eu-central-1

# Configure all five Web values together when browser identity issuance is enabled.
# Use an Auth0 EU tenant and a Regular Web Application client for the Web BFF.
# WEB_APP_ORIGIN=https://app.example.com
# OIDC_ISSUER_URL=https://login.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://app.example.com/api/auth/callback

# Configure both values together to enable native session exchange. Production requires at least
# one complete Web or native OIDC set.
# NATIVE_OIDC_CLIENT_ID=
# OIDC_API_AUDIENCE=urn:rillora:api

# Configure this entire block together only for the explicitly gated Stripe test integration.
# Require a restricted test key (rk_test_) with only the permissions the adapter needs.
# Never commit a real key or webhook signing secret.
# STRIPE_TEST_API_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# STRIPE_EXPECTED_ACCOUNT_ID=acct_1U6B2RCxTlowhyiG
# STRIPE_FAMILY_PRODUCT_ID=prod_V6O8lAFbTCDmKd
# STRIPE_FAMILY_MONTHLY_PRICE_ID=price_1U6BMoCxTlowhyiG7qsmBrdY
# STRIPE_FAMILY_ANNUAL_PRICE_ID=price_1U6BMnCxTlowhyiGJEC1w596
# STRIPE_CHECKOUT_SUCCESS_URL=https://app.staging.rillora.xyz/account/billing/complete?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=https://app.staging.rillora.xyz/account/billing
# STRIPE_PORTAL_RETURN_URL=https://app.staging.rillora.xyz/account/billing

# Configure the certificate directory whenever the Apple Sandbox integration gate is enabled.
# Add the three IAP credential values together only when authoritative Server API reconciliation is
# required. Never commit real values or place the private key in a shell argument.
# APPLE_ROOT_CERTIFICATE_DIRECTORY=/absolute/path/to/apps/api/certificates/apple
# APPLE_IAP_KEY_ID=
# APPLE_IAP_ISSUER_ID=
# APPLE_IAP_PRIVATE_KEY=
