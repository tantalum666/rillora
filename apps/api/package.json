{
  "name": "continuity-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "bootstrap:runtime": "tsx src/bootstrap-runtime.ts",
    "seed:dev": "tsx src/seed-dev.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-acm": "3.1137.0",
    "@aws-sdk/client-dynamodb": "3.1137.0",
    "@aws-sdk/client-kms": "3.1137.0",
    "cookie": "2.0.1",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "forwarded-parse": "2.1.2",
    "helmet": "8.3.0",
    "jose": "6.2.8",
    "openid-client": "^6.8.4",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "stripe": "^22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
