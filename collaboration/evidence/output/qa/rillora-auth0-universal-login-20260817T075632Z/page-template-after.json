{
  "body": "<!DOCTYPE html>\n{% assign resolved_dir = dir | default: \"auto\" %}\n<html lang=\"{{ locale }}\" dir=\"{{ resolved_dir }}\">\n  <head>\n    {%- auth0:head -%}\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n    <meta name=\"theme-color\" content=\"#171C1C\">\n    <title>{{ prompt.screen.texts.pageTitle }}</title>\n    <style>\n      :root {\n        color-scheme: dark;\n        --rillora-canvas: #171c1c;\n        --rillora-surface: #1d2322;\n        --rillora-surface-muted: #252c29;\n        --rillora-border: #39433f;\n        --rillora-ink: #f1ece2;\n        --rillora-body: #dad8cf;\n        --rillora-muted: #b8bab2;\n        --rillora-sage: #bfd79a;\n        --rillora-clay: #cb704c;\n        --prompt-width: 440px;\n        --font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", sans-serif;\n      }\n\n      * {\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        min-height: 100%;\n        margin: 0;\n        background: var(--rillora-canvas);\n      }\n\n      body {\n        min-height: 100vh;\n        min-height: 100dvh;\n        color: var(--rillora-body);\n        font-family: var(--font-family);\n      }\n\n      .rillora-auth {\n        display: grid;\n        grid-template-columns: minmax(320px, 0.82fr) minmax(520px, 1.18fr);\n        min-height: 100vh;\n        min-height: 100dvh;\n      }\n\n      .rillora-brand {\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n        min-width: 0;\n        padding: clamp(32px, 5vw, 72px);\n        border-right: 1px solid var(--rillora-border);\n        background: var(--rillora-surface);\n      }\n\n      .rillora-wordmark {\n        margin: 0;\n        color: var(--rillora-ink);\n        font-family: Georgia, \"Times New Roman\", serif;\n        font-size: 30px;\n        font-weight: 700;\n        line-height: 1;\n        letter-spacing: -0.02em;\n      }\n\n      .rillora-brand-copy {\n        max-width: 520px;\n      }\n\n      .rillora-kicker {\n        margin: 0 0 18px;\n        color: var(--rillora-sage);\n        font-size: 12px;\n        font-weight: 700;\n        letter-spacing: 0.18em;\n        line-height: 1.4;\n        text-transform: uppercase;\n      }\n\n      .rillora-title {\n        max-width: 10ch;\n        margin: 0;\n        color: var(--rillora-ink);\n        font-family: Georgia, \"Times New Roman\", serif;\n        font-size: clamp(40px, 5.2vw, 76px);\n        font-weight: 700;\n        letter-spacing: -0.04em;\n        line-height: 0.98;\n      }\n\n      .rillora-brand-note {\n        margin: 24px 0 0;\n        color: var(--rillora-muted);\n        font-size: 16px;\n        line-height: 1.55;\n      }\n\n      .rillora-auth-panel {\n        display: flex;\n        min-width: 0;\n        align-items: center;\n        justify-content: center;\n        padding: max(32px, env(safe-area-inset-top)) max(24px, env(safe-area-inset-right)) max(32px, env(safe-area-inset-bottom)) max(24px, env(safe-area-inset-left));\n        background: var(--rillora-canvas);\n      }\n\n      .rillora-widget-frame {\n        width: min(100%, 520px);\n      }\n\n      .rillora-mobile-wordmark {\n        display: none;\n      }\n\n      @media (max-width: 840px) {\n        :root {\n          --prompt-width: min(100%, 440px);\n        }\n\n        .rillora-auth {\n          display: block;\n        }\n\n        .rillora-brand {\n          display: none;\n        }\n\n        .rillora-auth-panel {\n          min-height: 100vh;\n          min-height: 100dvh;\n          align-items: flex-start;\n          padding-top: max(28px, env(safe-area-inset-top));\n        }\n\n        .rillora-widget-frame {\n          width: min(100%, 480px);\n          margin: 0 auto;\n        }\n\n        .rillora-mobile-wordmark {\n          display: block;\n          margin: 0 0 28px;\n          color: var(--rillora-ink);\n          font-family: Georgia, \"Times New Roman\", serif;\n          font-size: 28px;\n          font-weight: 700;\n          line-height: 1;\n          text-align: center;\n          letter-spacing: -0.02em;\n        }\n      }\n\n      @media (max-width: 480px) {\n        .rillora-auth-panel {\n          padding-right: max(12px, env(safe-area-inset-right));\n          padding-left: max(12px, env(safe-area-inset-left));\n        }\n\n        .rillora-mobile-wordmark {\n          margin-bottom: 18px;\n          font-size: 25px;\n        }\n      }\n\n      @media (prefers-reduced-motion: reduce) {\n        *,\n        *::before,\n        *::after {\n          scroll-behavior: auto !important;\n          transition-duration: 0.01ms !important;\n          animation-duration: 0.01ms !important;\n          animation-iteration-count: 1 !important;\n        }\n      }\n    </style>\n  </head>\n  <body class=\"_hide-prompt-logo\">\n    <main class=\"rillora-auth\">\n      <aside class=\"rillora-brand\" aria-label=\"Rillora\">\n        <p class=\"rillora-wordmark\">Rillora</p>\n        <div class=\"rillora-brand-copy\">\n          <p class=\"rillora-kicker\">Private continuity</p>\n          <h1 class=\"rillora-title\">A clear plan for what comes next.</h1>\n          <p class=\"rillora-brand-note\">Your account opens the private map you chose to create or continue.</p>\n        </div>\n      </aside>\n      <section class=\"rillora-auth-panel\" aria-label=\"Account access\">\n        <div class=\"rillora-widget-frame\">\n          <p class=\"rillora-mobile-wordmark\">Rillora</p>\n          {%- auth0:widget -%}\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n"
}