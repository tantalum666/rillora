              "price": "99.99",
              "balance": "84.99"
            },
            {
              "channel": "Apple同价30%",
              "price": "88.80",
              "balance": "62.16"
            },
            {
              "channel": "Apple候选30%",
              "price": "119.99",
              "balance": "83.99"
            }
          ],
          "methods": [
            {
              "language": "calculation",
              "code": "Web: 88.80 * (1 - 0.034 - 0.005 - 0.007) - 0.30 = 84.4152\nApple15%: 99.99 * 0.85 = 84.9915\nApple30%: 119.99 * 0.70 = 83.993"
