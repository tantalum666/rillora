    "AutoPublish": true,
    "FunctionCode": "function handler(event) {\n  var request = event.request;\n  if (request.method !== \"GET\" && request.method !== \"HEAD\") {\n    return {\n      statusCode: 405,\n      headers: {\n        \"cache-control\": { value: \"no-store\" },\n        allow: { value: \"GET, HEAD\" },\n      },\n    };\n  }\n  if (request.uri === \"/guides\" || request.uri === \"/guides/\") {\n    var providers = [\n      \"apple\",\n      \"google\",\n      \"microsoft\",\n      \"dropbox\",\n      \"yahoo\",\n      \"meta\",\n      \"instagram\",\n      \"linkedin\",\n      \"x\",\n      \"paypal\",\n      \"coinbase\",\n      \"binance\",\n      \"binance_us\",\n      \"github\",\n      \"password_manager\",\n      \"adobe\",\n      \"netflix\",\n      \"steam\",\n    ];\n    var service =\n      request.querystring &&\n      request.querystring.service &&\n      request.querystring.service.value;\n    var target = \"https://app.staging.rillora.xyz/account?next=guides\";\n    if (providers.indexOf(service) !== -1) target += \"&service=\" + service;\n    return {\n      statusCode: 302,\n      headers: {\n        location: { value: target },\n        \"cache-control\": { value: \"no-store\" },\n      },\n    };\n  }\n  if (\n    [\n      \"/\",\n      \"/product\",\n      \"/product/\",\n      \"/security\",\n      \"/security/\",\n      \"/pricing\",\n      \"/pricing/\",\n      \"/support\",\n      \"/support/\",\n      \"/legal\",\n      \"/legal/\",\n      \"/legal/licenses\",\n      \"/legal/licenses/\",\n    ].indexOf(request.uri) !== -1\n  ) {\n    request.uri = \"/index.html\";\n    return request;\n  }\n  if (\n    /^\\/assets\\/[A-Za-z0-9_-]+\\.(js|css|png|jpe?g|webp|svg|woff|woff2|txt)$/.test(\n      request.uri,\n    )\n  )\n    return request;\n  return {\n    statusCode: 404,\n    headers: { \"cache-control\": { value: \"no-store\" } },\n  };\n}\n",
