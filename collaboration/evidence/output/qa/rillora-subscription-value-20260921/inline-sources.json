    {
      "id": "intermittent-payments",
      "title": "低频月付与年付的金额差异",
      "queries": [
        {
          "id": "billing-arithmetic",
          "source": {
            "label": "Rillora当前USD目录",
            "files": [
              {
                "label": "product-catalog.json"
              },
              {
                "label": "billing-frequency.ipynb"
              }
            ],
            "metricDefinitions": [
              {
                "label": "12个月累计支付",
                "definition": "按每户不同假设支付模式，计算同一12个月窗口的累计支付金额。"
              }
            ],
            "caveats": [
              "这是情景算术，不是实际留存或收入预测。",
              "未扣税、手续费、退款和成本；不假设切成年付后转化率不变。"
            ]
          },
          "columns": [
            {
              "field": "scenario",
              "label": "假设支付模式"
            },
            {
              "field": "grossReceiptsUSD",
              "label": "12个月累计支付（USD）"
            }
          ],
          "rows": [
            {
              "scenario": "one paid month in one year",
              "paidMonths": 1,
              "grossReceiptsUSD": "9.99"
            },
            {
              "scenario": "one paid month each quarter",
              "paidMonths": 4,
              "grossReceiptsUSD": "39.96"
            },
            {
              "scenario": "annual subscription",
              "paidMonths": 12,
              "grossReceiptsUSD": "88.8"
            },
            {
              "scenario": "continuous monthly subscription",
              "paidMonths": 12,
              "grossReceiptsUSD": "119.88"
            }
          ],
          "methods": [
            {
              "language": "calculation",
              "code": "9.99 × 1 = 9.99\n9.99 × 4 = 39.96\nAnnual = 88.80\n9.99 × 12 = 119.88\n9.99 / 88.80 × 100 = 11.25%"
            }
          ]
        }
      ]
    },
    {
