  "compilerOptions": {
    "target":"ES2024", "lib":["ES2024","DOM"], "module":"ESNext", "moduleResolution":"Bundler",
    "strict":true, "noImplicitAny":false, "exactOptionalPropertyTypes":true, "allowJs":true, "checkJs":false,
    "esModuleInterop":true, "skipLibCheck":true, "noEmit":true,
