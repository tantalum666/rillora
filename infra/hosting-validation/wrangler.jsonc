{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rillora-hosting-validation-20261102",
  "account_id": "8035762329fae4920052e81df9baaa0c",
  "main": "worker.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "pino": "../../apps/api/node_modules/pino/pino.js",
    "pg": "../../apps/api/node_modules/pg",
    "stripe": "../../apps/api/node_modules/stripe",
    "@apple/app-store-server-library": "../../apps/api/node_modules/@apple/app-store-server-library"
  },
  "rules": [{"type": "Text", "globs": ["**/*.pem"], "fallthrough": true}],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "VALIDATION_MODE": "synthetic-only",
    "VALIDATION_EXPIRES_AT": "1970-01-01T00:00:00Z"
  },
  "hyperdrive": [{
    "binding": "DATABASE",
    "id": "4f27cc101d784395aaa249c92e3bad18"
  }],
  "secrets": {"required": ["PROBE_SECRET"]},
  "observability": {"enabled": true, "logs": {"enabled": true, "invocation_logs": false}}
}
